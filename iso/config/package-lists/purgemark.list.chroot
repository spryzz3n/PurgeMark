# Runtime for pmark, purgemark and purgemark-gui (built on the host and copied in by iso/build.sh)
libssl3t64
libstdc++6
libgtk-4-1

# Graphical kiosk
cage
fonts-dejavu-core

# Kiosk console. systemd-logind needs D-Bus; without it no getty spawns on
# other VTs and the ACPI power button is ignored (apt-recommends is off).
kbd
console-setup
dbus
libpam-systemd

# Drive diagnostics for operators on tty2 (not used by PurgeMark itself)
nvme-cli
hdparm
sg3-utils
smartmontools
pciutils
usbutils

# Mounting the PM-CERTS stick (FAT/exFAT)
dosfstools
exfatprogs
util-linux
