#!/bin/sh
# Runs inside the chroot while the image is built.
set -e

chmod 0755 /usr/local/bin/pmark /usr/local/bin/purgemark /usr/local/bin/purgemark-gui /usr/local/bin/purgemark-kiosk
systemctl enable purgemark.service

# Nothing in the live system may touch the target drives on its own.
systemctl mask udisks2.service 2>/dev/null || true
for unit in lvm2-monitor.service mdmonitor.service; do
    systemctl mask "$unit" 2>/dev/null || true
done

# Login banner on the debug consoles (tty2+).
printf 'PurgeMark live: the sanitization UI runs on tty1 (Ctrl+Alt+F1)\n\n' > /etc/issue
