#!/bin/sh
# Launches the PurgeMark TUI on tty1.
#
# Certificates must outlive the live session, so they go to a separate USB
# stick labelled PM-CERTS (FAT32 or exFAT). An operator signing key on that
# stick (operator.key, from `pmark keygen`) is used automatically. Being mounted
# also makes the stick show as "in use", so it can't be erased by mistake.

CERTS_DEV=$(blkid -L PM-CERTS 2>/dev/null || true)
MNT=/mnt/pm-certs
OUT=/run/purgemark/certificates
KEY=

if [ -n "$CERTS_DEV" ]; then
    mkdir -p "$MNT"
    if mountpoint -q "$MNT" || mount "$CERTS_DEV" "$MNT"; then
        OUT="$MNT/certificates"
        [ -f "$MNT/operator.key" ] && KEY="$MNT/operator.key"
    fi
fi
mkdir -p "$OUT"

clear
if [ "$OUT" = /run/purgemark/certificates ]; then
    printf '\n  No USB stick labelled PM-CERTS found.\n'
    printf '  Certificates will be kept in RAM and LOST at power-off.\n\n'
    printf '  Insert one and press r to rescan, or press Enter to continue anyway.\n'
    read -r answer
    [ "$answer" = r ] && exit 0  # systemd restarts us and we look again
fi

# --experimental lists the untested firmware sanitize methods (marked as such);
# the UI still preselects a tested method.
if [ -n "$KEY" ]; then
    exec /usr/local/bin/purgemark --kiosk --experimental --out "$OUT" --key "$KEY"
fi
exec /usr/local/bin/purgemark --kiosk --experimental --out "$OUT"
