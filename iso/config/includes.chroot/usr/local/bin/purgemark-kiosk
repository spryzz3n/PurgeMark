#!/bin/sh
# Launches the PurgeMark UI on tty1: the GTK app under Cage, or the terminal UI
# if the graphical one can't start.
#
# Certificates must outlive the live session, so they go to a separate USB
# stick labelled PM-CERTS (FAT32 or exFAT). An operator signing key on that
# stick (operator.key, from `pmark keygen`) is used automatically. Being mounted
# also makes the stick show as "in use", so it can't be erased by mistake.

CERTS_DEV=$(blkid -L PM-CERTS 2>/dev/null || true)
MNT=/mnt/pm-certs
RUN=/run/purgemark
OUT=$RUN/certificates
KEY=
VOLATILE=--certs-volatile

if [ -n "$CERTS_DEV" ]; then
    mkdir -p "$MNT"
    if mountpoint -q "$MNT" || mount "$CERTS_DEV" "$MNT"; then
        OUT="$MNT/certificates"
        VOLATILE=
        [ -f "$MNT/operator.key" ] && KEY="--key $MNT/operator.key"
    fi
fi
mkdir -p "$OUT"
mkdir -p -m 700 "$RUN/xdg"

# --experimental lists the untested firmware sanitize methods (marked as such);
# the UI still preselects a tested method.
STARTED=$RUN/gui-started
rm -f "$STARTED"
XDG_RUNTIME_DIR=$RUN/xdg WLR_RENDERER=pixman GSK_RENDERER=cairo \
    cage -s -- /usr/local/bin/purgemark-gui --kiosk --experimental --out "$OUT" $KEY $VOLATILE \
        --started-file "$STARTED"

# Cage's exit status says little, so go by whether the window ever came up.
# If it did, exit and let systemd start us again, which also picks up a new stick.
[ -f "$STARTED" ] && exit 0

clear
if [ -n "$VOLATILE" ]; then
    printf '\n  No USB stick labelled PM-CERTS found.\n'
    printf '  Certificates will be kept in RAM and LOST at power-off.\n\n'
    printf '  Insert one and press r to rescan, or press Enter to continue anyway.\n'
    read -r answer
    [ "$answer" = r ] && exit 0
fi
exec /usr/local/bin/purgemark --kiosk --experimental --out "$OUT" $KEY
