#!/bin/sh
# live-build configuration for the ZeroTrace ISO (Debian 13 "trixie", amd64).
set -e

# noswap:  never activate swap found on the drives we are about to erase.
# nopersistence: the live system writes nothing back to any disk.
lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free-firmware" \
  --debian-installer none \
  --binary-image iso-hybrid \
  --apt-recommends false \
  --memtest none \
  --firmware-binary true \
  --firmware-chroot true \
  --iso-application "ZeroTrace" \
  --iso-volume "ZEROTRACE" \
  --iso-publisher "ZeroTrace; https://github.com/" \
  --bootappend-live "boot=live components quiet loglevel=3 noswap nopersistence" \
  "${@}"
