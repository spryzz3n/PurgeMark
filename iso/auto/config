#!/bin/sh
# live-build configuration for the PurgeMark ISO (Debian 13 "trixie", amd64).
set -e

# noswap:  never activate swap found on the drives we are about to erase.
# nopersistence: the live system writes nothing back to any disk.
# live-config.noautologin: live-config would otherwise auto-login a "user"
#   account (which we don't create) on every VT, overriding our tty2 shell.
lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free-firmware" \
  --debian-installer none \
  --binary-image iso-hybrid \
  --apt-recommends false \
  --memtest none \
  --firmware-binary true \
  --firmware-chroot true \
  --iso-application "PurgeMark" \
  --iso-volume "PURGEMARK" \
  --iso-publisher "PurgeMark; https://github.com/" \
  --bootappend-live "boot=live components quiet loglevel=3 noswap nopersistence live-config.noautologin live-config.hostname=purgemark" \
  "${@}"
